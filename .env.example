# LOCAL DEVELOPMENT ONLY. Copy this file to .env and choose a unique password.
# This root user is provided by the Docker MongoDB container for classroom use.
MONGO_ROOT_PASSWORD=replace_this_with_a_local_password

# Example connection URI for MongoDB Compass or your Node.js backend:
# mongodb://capo_root:<YOUR_PASSWORD>@127.0.0.1:27017/capo_db?authSource=admin
# For MongoDB Atlas use your Atlas URI instead; never commit real credentials.
